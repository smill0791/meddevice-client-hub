<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/Tooling">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="accountId" type="String" label="Account ID"
                description="Optional. Leave blank to use the logged-in portal user's account." />
            <property name="maxItems" type="Integer" label="Max Items" default="5"
                description="How many recent items to show." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
