<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/metadata">
    <label>MedDevice Portal User</label>
    <description>Grants portal users field- and object-level access to the MedDevice Client Hub data model. Portal users can read their account's devices, work orders, and service contracts, and create/edit support cases.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- ===== Object Permissions ===== -->
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Asset</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Case</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Work_Order__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Service_Contract__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ===== Field Permissions: Account ===== -->
    <fieldPermissions>
        <field>Account.Region__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ===== Field Permissions: Asset ===== -->
    <fieldPermissions>
        <field>Asset.Device_Category__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Warranty_Expiry__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Error_Code__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ===== Field Permissions: Case ===== -->
    <fieldPermissions>
        <field>Case.Error_Code__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Resolution_Notes__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Device_Category__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ===== Field Permissions: Contact ===== -->
    <fieldPermissions>
        <field>Contact.Portal_Role__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Contact.Department__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ===== Field Permissions: Work_Order__c ===== -->
    <fieldPermissions>
        <field>Work_Order__c.Case__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Asset__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Technician_Name__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Scheduled_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Completed_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Status__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Parts_Required__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Work_Order__c.Service_Notes__c</field>
        <editable>false</editable>
