    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Contract__c.SLA_Response_Hours__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ===== Apex Class Access ===== -->
    <classAccesses>
        <apexClass>AssetController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CaseController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>WorkOrderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>KnowledgeController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AgentResponseController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PortalContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
