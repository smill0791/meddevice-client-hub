    <fieldPermissions>
        <field>Service_Contract__c.Account__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Contract__c.Start_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Contract__c.End_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Contract__c.Coverage_Level__c</field>
        <editable>false</editable>
